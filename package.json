{
  "name": "icet",
  "version": "0.1.0",
  "private": true,
  "description": "ICET - Internal Control Evaluation Testing System",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check . && turbo run typecheck",
    "lint:fix": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "arm64"
      ]
    }
  }
}
